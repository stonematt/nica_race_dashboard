#!/bin/sh
#
# Refuse any commit that stages a fixture payload.
#
# This repository is public and the RaceResult payloads carry minors' full
# names, schools, grades, plates and finish times. The corpus lives in the tree
# (issue #30) so the fidelity suite can find it with no machine-local setting;
# this hook is what replaces the guarantee we gave up by moving it in.
#
# .gitignore is a request and `git add -f` overrides it. This reads the index,
# so it catches the forced add too — by then the payload is staged either way.
#
# Three checks, because a path check alone has obvious holes: staging a payload
# under fixtures/, staging one that was renamed OUT of fixtures/ in the same
# commit, and staging a symlink that lands in the corpus under some other name
# (issue #58). A payload *copied* to a new path carries no rename record and
# gets past all three — that is the shape-level guard's job in CI (issue #28),
# not a path check's. Say so out loud rather than implying this hook is
# airtight.
#
# Fails closed: if git cannot be asked what is staged, the commit is refused.
# Every read of the index is therefore its own unpiped command substitution and
# is filtered afterwards — `X=$(git ... | awk ...)` reports awk's exit status,
# not git's, so a git that died mid-stream would read as an empty index and
# wave the commit through. There is no `pipefail` in POSIX sh to lean on.
#
# Installed by `pnpm install` (scripts/install-git-hooks.mjs sets
# core.hooksPath). POSIX sh with no dependencies on purpose: it has to run
# during a commit on a machine where node_modules may be half-installed.

set -eu

# :(top) anchors the pathspec at the repo root rather than the caller's cwd.
# --diff-filter=ACMR: additions, copies, modifications, renames. A staged
# deletion of a payload that somehow reached history is exactly what someone
# cleaning up needs to be able to commit.
if ! staged=$(git diff --cached --name-only --diff-filter=ACMR -- ':(top)fixtures'); then
  echo 'pre-commit: could not read the index; refusing to commit.' >&2
  exit 1
fi

# Rename detection is off by default for --name-only, so ask for it explicitly.
# `git mv fixtures/2025/x.json notes.json` stages the payload's bytes at a path
# the check above never looks at.
if ! renames=$(git diff --cached --name-status --find-renames --diff-filter=R); then
  echo 'pre-commit: could not read the index; refusing to commit.' >&2
  exit 1
fi
renamed=$(printf '%s\n' "$renames" | awk -F'\t' '$2 ~ /^fixtures\// { print $2 " -> " $3 }')

# A staged symlink is mode 120000 in the index. The pathspec above only knows
# the name `fixtures`, so `ln -s fixtures fixtures2` walked straight past it
# (#58); scripts/privacy-guard.ts follows the link instead, and this is the
# local half agreeing with it. Two independent layers catching the same set is
# the property the whole defence rests on.
#
# --raw prints `:<srcmode> <dstmode> <sha> <sha> <status>\t<path>`, with the
# destination path last on a rename.
if ! entries=$(git diff --cached --raw --diff-filter=ACMR); then
  echo 'pre-commit: could not read the index; refusing to commit.' >&2
  exit 1
fi
links=$(printf '%s\n' "$entries" |
  awk -F'\t' '{ split($1, meta, " "); if (meta[2] == "120000") print (NF >= 3 ? $3 : $2) }')

if ! root=$(git rev-parse --show-toplevel); then
  echo 'pre-commit: could not find the repository root; refusing to commit.' >&2
  exit 1
fi
root=$(cd -P -- "$root" && pwd -P)

corpus_links=''
broken_links=''

# A here-doc rather than a pipe: a `while` on the right of a pipe runs in a
# subshell in most shells, and the two accumulators below would not survive it.
while IFS= read -r link; do
  [ -n "$link" ] || continue

  # -e follows the link, so this is false exactly when it dangles. A link whose
  # destination cannot be read is refused, not cleared: fail closed.
  if [ ! -e "$root/$link" ]; then
    broken_links="$broken_links$link
"
    continue
  fi

  # `cd -P` resolves every symlink on the way, which is what the guard's
  # realpath() does. It only works on a directory; a link to a *file* takes one
  # hop with readlink and resolves the directory that hop lands in, which
  # follows any chain of directory links the same way realpath() would.
  if target=$(cd -P -- "$root/$link" 2>/dev/null && pwd -P); then
    :
  else
    parent=$(cd -P -- "$(dirname -- "$root/$link")" 2>/dev/null && pwd -P) || parent=$root
    raw=$(readlink -- "$root/$link" 2>/dev/null) || raw=''
    case "$raw" in
      /*) hop=$raw ;;
      '') hop="$root/$link" ;;
      *) hop="$parent/$raw" ;;
    esac
    # Resolve the directory that hop lands in, not the one the link sits in:
    # `evidence.json -> linkdir/raw.json` with `linkdir -> fixtures/2025` is in
    # the corpus, and stopping at the link's own parent would miss it while
    # realpath() on the guard's side would not.
    dir=$(cd -P -- "$(dirname -- "$hop")" 2>/dev/null && pwd -P) || dir=$(dirname -- "$hop")
    target="$dir/$(basename -- "$hop")"
  fi

  # Relative to the repo root when it lands inside, absolute when it does not —
  # the corpus has a second copy under ~/.local/share/. Same normalization as
  # the guard, so a checkout that lives under a directory called `data` does not
  # make every link in it a finding.
  case "$target" in
    "$root"/*) rel=${target#"$root"/} ;;
    *) rel=$target ;;
  esac

  case "/$rel/" in
    */fixtures/* | */data/*)
      corpus_links="$corpus_links$link -> $rel
"
      ;;
  esac
done <<EOF
$links
EOF

if [ -z "$staged" ] && [ -z "$renamed" ] && [ -z "$corpus_links" ] && [ -z "$broken_links" ]; then
  exit 0
fi

{
  echo
  echo '  BLOCKED: this commit stages fixture payloads.'
  echo
  if [ -n "$staged" ]; then
    printf '%s\n' "$staged" | sed 's/^/    /'
  fi
  if [ -n "$renamed" ]; then
    printf '%s\n' "$renamed" | sed 's/^/    renamed out of the corpus: /'
  fi
  if [ -n "$corpus_links" ]; then
    printf '%s' "$corpus_links" | sed 's/^/    symlink into the corpus: /'
  fi
  if [ -n "$broken_links" ]; then
    printf '%s' "$broken_links" |
      sed 's/^/    symlink whose target could not be resolved, so it cannot be cleared: /'
  fi
  echo
  echo "  This repository is public and these payloads carry minors' full names,"
  echo '  schools, grades, plates and finish times. Nothing under fixtures/ is ever'
  echo '  committed — not redacted, not "just the small one", not temporarily.'
  echo
  echo '  If you have data that genuinely belongs in the repo, it does not belong'
  echo '  under fixtures/. Move it out, pseudonymize it («RIDER-A»), and commit it'
  echo '  from its own path.'
  echo
  echo '  See docs/fixtures.md. If you are certain this block is wrong, the escape'
  echo '  is `git commit --no-verify` — take it only as a deliberate decision, and'
  echo '  say in the pull request why the payload is safe to publish.'
  echo
} >&2

exit 1
