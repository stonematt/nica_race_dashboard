#!/bin/sh
#
# Refuse any commit that stages a fixture payload.
#
# This repository is public and the RaceResult payloads carry minors' full
# names, schools, grades, plates and finish times. The corpus lives in the tree
# (issue #30) so the fidelity suite can find it with no machine-local setting;
# this hook is what replaces the guarantee we gave up by moving it in.
#
# .gitignore is a request and `git add -f` overrides it. This reads the index,
# so it catches the forced add too — by then the payload is staged either way.
#
# Two checks, because a path check alone has an obvious hole: staging a payload
# under fixtures/, and staging one that was renamed OUT of fixtures/ in the same
# commit. A payload *copied* to a new path carries no rename record and gets
# past both — that is the shape-level guard's job in CI (issue #28), not a path
# check's. Say so out loud rather than implying this hook is airtight.
#
# Fails closed: if git cannot be asked what is staged, the commit is refused.
#
# Installed by `pnpm install` (scripts/install-git-hooks.mjs sets
# core.hooksPath). POSIX sh with no dependencies on purpose: it has to run
# during a commit on a machine where node_modules may be half-installed.

set -eu

# :(top) anchors the pathspec at the repo root rather than the caller's cwd.
# --diff-filter=ACMR: additions, copies, modifications, renames. A staged
# deletion of a payload that somehow reached history is exactly what someone
# cleaning up needs to be able to commit.
if ! staged=$(git diff --cached --name-only --diff-filter=ACMR -- ':(top)fixtures'); then
  echo 'pre-commit: could not read the index; refusing to commit.' >&2
  exit 1
fi

# Rename detection is off by default for --name-only, so ask for it explicitly.
# `git mv fixtures/2025/x.json notes.json` stages the payload's bytes at a path
# the check above never looks at.
if ! renamed=$(git diff --cached --name-status --find-renames --diff-filter=R |
  awk -F'\t' '$2 ~ /^fixtures\// { print $2 " -> " $3 }'); then
  echo 'pre-commit: could not read the index; refusing to commit.' >&2
  exit 1
fi

if [ -z "$staged" ] && [ -z "$renamed" ]; then
  exit 0
fi

{
  echo
  echo '  BLOCKED: this commit stages fixture payloads.'
  echo
  if [ -n "$staged" ]; then
    printf '%s\n' "$staged" | sed 's/^/    /'
  fi
  if [ -n "$renamed" ]; then
    printf '%s\n' "$renamed" | sed 's/^/    renamed out of the corpus: /'
  fi
  echo
  echo "  This repository is public and these payloads carry minors' full names,"
  echo '  schools, grades, plates and finish times. Nothing under fixtures/ is ever'
  echo '  committed — not redacted, not "just the small one", not temporarily.'
  echo
  echo '  If you have data that genuinely belongs in the repo, it does not belong'
  echo '  under fixtures/. Move it out, pseudonymize it («RIDER-A»), and commit it'
  echo '  from its own path.'
  echo
  echo '  See docs/fixtures.md. If you are certain this block is wrong, the escape'
  echo '  is `git commit --no-verify` — take it only as a deliberate decision, and'
  echo '  say in the pull request why the payload is safe to publish.'
  echo
} >&2

exit 1
