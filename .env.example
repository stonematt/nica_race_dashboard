# Local database. PGlite writes a directory, not a file; point at Neon to host.
DATABASE_URL="./.pglite"

# next-auth v5. Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Per-coach accounts are email-allowlisted (see issue #3). Comma-separated.
# Nobody outside this list can sign in, whatever the provider says.
AUTH_ALLOWED_EMAILS="coach@example.org"

# Magic-link sign-in. Unset in development and the dev login below is the only way in.
AUTH_EMAIL_SERVER=""
AUTH_EMAIL_FROM=""

# Development only: sign in as an allowlisted address with no mail server.
# Refuses to load when NODE_ENV=production — see src/auth.ts.
AUTH_DEV_LOGIN="1"
