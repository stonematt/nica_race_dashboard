# Local database. PGlite writes a directory, not a file; point at Neon to host.
DATABASE_URL="./.pglite"

# next-auth v5. Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Per-coach accounts are email-allowlisted (see issue #3). Comma-separated.
# Nobody outside this list can sign in by magic link, whatever the provider
# says. It does not apply to the development shim below, which has no list.
AUTH_ALLOWED_EMAILS="coach@example.org"

# Magic-link sign-in. Unset in development and the dev login below is the only way in.
AUTH_EMAIL_SERVER=""
AUTH_EMAIL_FROM=""

# Development only: sign in as ANY address, with no mail server and no
# allowlist. Nothing proves you control the address you type.
#
# What makes that safe is that `pnpm dev` binds 127.0.0.1, so this server is
# reachable only from the machine running it. Do not drop the --hostname flag
# from the dev script and leave this switched on — on shared wifi at a race
# venue that is every device on the LAN reading minors' names.
#
# Refuses to load when NODE_ENV=production — see src/auth.ts. Off by default:
# a sample file that ships a second sign-in path already switched on is how it
# ends up switched on somewhere it shouldn't be. Set to 1 deliberately.
AUTH_DEV_LOGIN=""
