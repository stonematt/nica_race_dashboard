node_modules/
.next/
out/
build/
coverage/

# PGlite's on-disk database — local derived state, never committed
.pglite/

# The fixture corpus lives here, in the tree, and is never committed: the
# payloads carry minors' full names, schools, grades and finish times, and this
# repo is public. This line stops an ordinary `git add`; scripts/git-hooks/
# pre-commit reads the index and so stops `git add -f` too. See docs/fixtures.md.
data/
fixtures/

# The trailing-slash patterns above match a real directory named `data` or
# `fixtures` but not a symlink of the same name — a symlink is a file to git,
# not a directory. A worktree that symlinks the corpus in rather than copying
# it (docs/fixtures.md) hits exactly this gap: `git status` reports the
# symlink untracked and `git add .` stages it. These root-anchored, no-slash
# entries catch the symlink form too. See #52.
/data
/fixtures

.env
.env.*
!.env.example

.DS_Store
*.log
.playwright-mcp/
tsconfig.tsbuildinfo

# Generated by Next on every build; regenerated, never hand-edited.
next-env.d.ts

# Agent worktrees and local session state.
.claude/worktrees/
